# Copy this file to `infra/.env` and fill in real values, then run
# `docker compose up`. infra/.env is gitignored; this template is not.
#
# Ask a teammate for these — they are NOT in the repo by design.

# Supabase project secret key (Project Settings -> API Keys -> sb_secret_...).
# Bypasses row-level security. Server-side only — never expose to the browser
# and never put it in frontend/.env.local.
SUPABASE_SECRET_KEY=

# Cloudflare R2 (R2 -> Manage API tokens). Scoped to the `brain` bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
